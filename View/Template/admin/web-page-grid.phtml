<?php

use Krystal\Form\Element;
use Krystal\Widget\GridView\GridViewWidget;
use Cms\View\Icon;

$options = $this->translateArray([
    '1' => 'This poll is published', 
    '0' => 'This poll is not published'
]);

?>

<h3 class="page-header mb-3"><?= $title; ?></h3>

<div class="card card-body mb-3">
    <form method="POST" autocomplete="off">
        <div class="row">
            <div class="col-lg-6">
                <?= Element::hidden('id', $webPage->getId()); ?>
                <?= Element::hidden('web_page_id', $entity->getWebPageId()); ?>
                <?= Element::text('name', $webPage->getName(), ['class' => 'form-control form-control-lg mb-2', 'placeholder' => $this->translate('Poll title')]); ?>
                <?= Element::select('published', $options, $webPage->getPublished(), ['class' => 'form-select form-select-lg']); ?>
            </div>

            <div class="col-lg-6">
                <p>
                    <button type="submit" data-button="save" data-url="<?= $this->url('Polls:Admin:WebPage@settingsAction', $entity->getWebPageId()); ?>" class="btn btn-primary"><i class="bi bi-save"></i> <?= $this->translate('Save'); ?></button>
                    <br />
                    <?= $this->translate('Display settings of this poll'); ?>
                </p>
            </div>
        </div>
    </form>
</div>

<div class="card card-body mb-3">
    <h2 class="page-header mb-3"><i class="fas fa-bar-chart"></i> <?= $this->translate('Answers'); ?> (<?= count($answers); ?>)</h2>

    <?= $this->widget(new GridViewWidget($answers, [
        'tableClass' => 'table table-hover table-bordered table-striped table-sm',
        'rowAttributes' => [
            'class' => function($answer) use ($entity){
                return $answer->getId() == $entity->getId() ? 'table-info' : null;
            }
        ],

        'columns' => [
            [
                'column' => 'id',
                'label' => '#'
            ],

            [
                'column' => 'title'
            ],

            [
                'column' => 'order'
            ],

            [
                'column' => 'published',
                'translateable' => true,
                'value' => function($answer){
                    return $answer->getPublished() ? 'Yes' : 'No';
                }
            ],

            [
                'column' => 'votes'
            ]
        ],

        'actions' => [
            function($answer) use ($title, $module, $backUrl){
                // Generate URL
                $url = $this->createQueryUrl('Polls:Admin:WebPage@editAction', [
                    'id' => $answer->getId(),
                    'title' => $title,
                    'module' => $module,
                    'back_url' => rawurlencode($backUrl)]
                );

                return Icon::edit($url, $this->translate('Edit this answer'));
            },

            function($answer){
                return Icon::remove(
                    $this->url('Polls:Admin:WebPage@deleteAction', $answer->getId()),
                    $this->translate('Remove this answer')
                );
            }
        ]
    ])); ?>
</div>

<div class="card card-body">
    <h2 class="page-header mb-3"><i class="bi bi-pencil"></i> <?= $this->translate($entity->getId() ? 'Edit the answer' : 'Add new answer'); ?></h2>

    <form autocomplete="off">
        <?= Element::hidden('answer[id]', $entity->getId()); ?>
        <?= Element::hidden('answer[web_page_id]', $entity->getWebPageId()); ?>

        <div class="row mb-3">
            <label class="col-lg-12 col-form-label"><?= $this->translate('Answer'); ?></label>
            <div class="col-lg-10">
                <div class="input-group">
                    <?= Element::text('answer[title]', $entity->getTitle(), ['class' => 'form-control', 'placeholder' => $this->translate('Option name')]); ?>
                    <span class="input-group-text"><i class="bi bi-pencil"></i></span>
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-lg-12 col-form-label"><?= $this->translate('Order'); ?></label>
            <div class="col-lg-10">
                <div class="input-group">
                    <?= Element::text('answer[order]', $entity->getOrder(), ['class' => 'form-control', 'placeholder' => $this->translate('Sorting order')]); ?>
                    <span class="input-group-text"><i class="bi bi-pencil"></i></span>
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-lg-12 col-form-label"><?= $this->translate('Published'); ?></label>
            <div class="col-lg-10">
                <div class="form-check">
                    <?= Element::checkbox('answer[published]', $entity->getPublished(), ['class' => 'form-check-input']); ?>
                </div>
            </div>
        </div>

        <?php
            $indexUrl =  $this->createQueryUrl('Polls:Admin:WebPage@indexAction', [
                'web_page_id' => $entity->getWebPageId(), 
                'title' => $title, 
                'module' => $module, 
                'back_url' => rawurlencode($backUrl)]
            );
        ?>

        <?php $this->loadPartial('actions', [
            'wrapperClass' => false,
            'new' => !$entity->getId(),
            'add' => $indexUrl,
            'edit' => $this->createQueryUrl('Polls:Admin:WebPage@editAction', [
                'title' => $title,
                'back_url' => rawurlencode($backUrl),
                'module' => $module,
                'id' => ''
            ]),
            'save' => 'Polls:Admin:WebPage@saveAction',
            'cancel' => $entity->getId() ? $indexUrl: $backUrl
        ]); ?>

    </form>
</div>