<?php

use Krystal\Form\Element;

?>

<form class="card" autocomplete="off">
    <div class="card-body">
        <?= Element::hidden('category[id]', $category->getId()); ?>

        <div class="row mb-3">
            <label class="col-lg-2 col-form-label"><?= $this->translate('Name'); ?></label>
            <div class="col-lg-10">
                <div class="input-group">
                    <?= Element::text('category[name]', $category->getName(), ['class' => 'form-control', 'placeholder' => $this->translate('Category name')]); ?>
                    <span class="input-group-text"><i class="bi bi-pencil"></i></span>
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-lg-2 col-form-label"><?= $this->translate('Class'); ?></label>
            <div class="col-lg-10">
                <div class="input-group">
                    <?= Element::text('category[class]', $category->getClass(), ['class' => 'form-control', 'placeholder' => $this->translate('Class name to be used when rendering on site')]); ?>
                    <span class="input-group-text"><i class="bi bi-pencil"></i></span>
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-lg-2 col-form-label"><?= $this->translate('Active'); ?></label>
            <div class="col-lg-10">
                <div class="form-check">
                    <?= Element::checkbox('category[active]', $category->getActive(), ['class' => 'form-check-input']); ?>
                </div>
            </div>
        </div>

        <?php $this->loadPartial('actions', [
            'new' => !$category->getId(),
            'add' => 'Polls:Admin:Category@addAction',
            'edit' => 'Polls:Admin:Category@editAction',
            'save' => 'Polls:Admin:Category@saveAction',
            'cancel' => 'Polls:Admin:Browser@indexAction'
        ]); ?>
    </div>
</form>