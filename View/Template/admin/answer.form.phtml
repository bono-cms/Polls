<?php

use Krystal\Form\Element;

?>

<form class="card" autocomplete="off">
    <div class="card-body">
        <?= Element::hidden('answer[id]', $answer->getId()); ?>

        <div class="row mb-3">
            <label class="col-lg-12 col-form-label"><?= $this->translate('Answer'); ?></label>
            <div class="col-lg-10">
                <div class="input-group">
                    <?= Element::text('answer[title]', $answer->getTitle(), ['class' => 'form-control', 'placeholder' => $this->translate('Option name')]); ?>
                    <span class="input-group-text"><i class="bi bi-pencil"></i></span>
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-lg-12 col-form-label"><?= $this->translate('Category'); ?></label>
            <div class="col-lg-10">
                <?= Element::select('answer[category_id]', $categories, $answer->getCategoryId(), ['class' => 'form-select']); ?>
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-lg-12 col-form-label"><?= $this->translate('Order'); ?></label>
            <div class="col-lg-10">
                <div class="input-group">
                    <?= Element::number('answer[order]', $answer->getOrder(), ['min' => '0', 'class' => 'form-control', 'placeholder' => $this->translate('Sorting order of this option to be displayed in a category')]); ?>
                    <span class="input-group-text"><i class="bi bi-pencil"></i></span>
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-lg-12 col-form-label"><?= $this->translate('Published'); ?></label>
            <div class="col-lg-10">
                <div class="form-check">
                    <?= Element::checkbox('answer[published]', $answer->getPublished(), ['class' => 'form-check-input']); ?>
                </div>
            </div>
        </div>

        <?php $this->loadPartial('actions', [
            'new' => !$answer->getId(),
            'add' => ['Polls:Admin:Answer@addAction', $answer->getCategoryId()],
            'edit' => 'Polls:Admin:Answer@editAction',
            'save' => 'Polls:Admin:Answer@saveAction',
            'cancel' => 'Polls:Admin:Browser@indexAction'
        ]); ?>
    </div>
</form>