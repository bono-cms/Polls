<?php

use Krystal\Form\Element;
defined('KRYSTAL') or die;

?>

<form class="card" data-group="answer" autocomplete="off">
    <?= Element::hidden('answer[id]', $answer->getId()); ?>

    <div class="form-group">
        <label class="col-lg-12 control-label"><?php $this->show('Answer'); ?></label>
        <div class="col-lg-10">
            <div class="input-group">
                <?= Element::text('answer[title]', $answer->getTitle(), ['class' => 'form-control', 'placeholder' => $this->translate('Option name')]); ?>
                <span class="input-group-addon"><i class="glyphicon glyphicon-pencil"></i></span>
            </div>
        </div>
    </div>

    <div class="form-group">
        <label class="col-lg-12 control-label"><?php $this->show('Category'); ?></label>
        <div class="col-lg-10">
            <?= Element::select('answer[category_id]', $categories, $answer->getCategoryId(), ['class' => 'form-control']); ?>
        </div>
    </div>

    <div class="form-group">
        <label class="col-lg-12 control-label"><?php $this->show('Order'); ?></label>
        <div class="col-lg-10">
            <div class="input-group">
                <?= Element::number('answer[order]', $answer->getOrder(), ['min' => '0', 'class' => 'form-control', 'placeholder' => $this->translate('Sorting order of this option to be displayed in a category')]); ?>
                <span class="input-group-addon"><i class="glyphicon glyphicon-pencil"></i></span>
            </div>
        </div>
    </div>

    <div class="form-group">
        <label class="col-lg-12 control-label"><?php $this->show('Published'); ?></label>
        <div class="col-lg-10">
            <?= Element::checkbox('answer[published]', $answer->getPublished(), ['class' => 'form-control']); ?>
        </div>
    </div>

    <?php $this->loadPartial('actions', [
        'new' => !$answer->getId(),
        'add' => ['Polls:Admin:Answer@addAction', $answer->getCategoryId()],
        'edit' => 'Polls:Admin:Answer@editAction',
        'save' => 'Polls:Admin:Answer@saveAction',
        'cancel' => 'Polls:Admin:Browser@indexAction'
    ]); ?>

</form>