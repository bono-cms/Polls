<?php

$poll = $polls->getAllByWebPageId($id);

?>

<?php if ($poll !== false): ?>
<div class="polls-wrapper">
    <h4><?= $poll->getName(); ?></h4>

    <form data-type="polls" action="<?= $this->url('Polls:WebPage@voteAction'); ?>" method="POST">
        <input type="hidden" name="web_page_id" value="<?= $poll->getWebPageId(); ?>" />

        <div class="mb-3">
            <div class="col-lg-10">
                <?php foreach ($poll->getAnswers() as $answer): ?>
                <div class="form-check">
                    <input type="radio" name="answer_id" value="<?= $answer->getId(); ?>" class="form-check-input" id="answer-<?= $answer->getId(); ?>" /> 
                    <label class="form-check-label" for="answer-<?= $answer->getId(); ?>"><?= $answer->getTitle(); ?></label>
                </div>
                <?php endforeach; ?>
            </div>
        </div>

        <div class="mb-3">
            <button type="submit" class="btn btn-primary" disabled><i class="bi bi-check-circle"></i> <?= $this->translate('Vote'); ?></button>
            <button type="results" data-url="<?= $this->url('Polls:WebPage@resultsAction', $poll->getWebPageId()); ?>" class="btn btn-info"><i class="bi bi-bar-chart"></i> <?= $this->translate('Results'); ?></button>
        </div>
    </form>
</div>
<?php endif; ?>