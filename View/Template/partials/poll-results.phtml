<?php if (!empty($answers)): ?>

<h4><?= $category; ?></h4>

<?php foreach ($answers as $answer): ?>
<strong><?= $answer->getTitle(); ?></strong><span class="float-end"><?= $answer->getVotes(); ?></span>

<div class="progress">
    <div class="progress-bar bg-info progress-bar-striped" role="progressbar" aria-valuenow="<?= $answer->getVotesPercentage(); ?>" aria-valuemin="0" aria-valuemax="100" style="width:<?= $answer->getVotesPercentage(); ?>%">
    </div>
</div>
<?php endforeach; ?>

<p><?= $this->translate('Total votes'); ?>: <?= $total; ?></p>

<?php else: ?>
<p class="text-muted"><?= $this->translate('No votes at the moment'); ?></p>
<?php endif; ?>